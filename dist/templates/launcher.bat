@echo off
rem SPDX-License-Identifier: Apache-2.0
rem
rem Start script of "@COMMAND@" from the Cringle distribution (generated by `gradlew cringleDist`).
rem
rem Cringle needs a JDK 21 or newer. The script uses %JAVA_HOME%\bin\java if JAVA_HOME is set and java from the PATH
rem otherwise, and stops with exit code 1 and a message if that is missing or older than 21.
rem Extra JVM options can be given in CRINGLE_JVM_OPTS.
rem
rem No command of this script stands in a parenthesized block that expands a path: a path such as
rem "C:\Program Files (x86)\..." would end the block early.
setlocal

for %%i in ("%~dp0..") do set "APP_HOME=%%~fi"

set "JAVACMD=java"
if defined JAVA_HOME set "JAVACMD=%JAVA_HOME%\bin\java"

rem `call`: a java that is a .cmd or .bat file (a wrapper) would end this script if it were started without it
call "%JAVACMD%" -version >nul 2>nul
if errorlevel 1 goto nojava

set "JAVA_MAJOR="
for /f "tokens=3" %%v in ('"%JAVACMD%" -version 2^>^&1') do if not defined JAVA_MAJOR set "JAVA_MAJOR=%%~v"
if not defined JAVA_MAJOR goto unknownversion
set "JAVA_FULL=%JAVA_MAJOR%"
for /f "delims=-.+" %%m in ("%JAVA_MAJOR%") do set "JAVA_MAJOR=%%m"
for /f "delims=0123456789" %%x in ("%JAVA_MAJOR%") do goto unknownversion
if %JAVA_MAJOR% LSS 21 goto tooold

"%JAVACMD%" %CRINGLE_JVM_OPTS% "-Dcringle.home=%APP_HOME%" -cp "%APP_HOME%\lib\*" @MAIN_CLASS@ %*
exit /b %ERRORLEVEL%

:nojava
echo @COMMAND@: no Java found (%JAVACMD%). Cringle needs a JDK 21 or newer: set JAVA_HOME to it or put java on the PATH. 1>&2
exit /b 1

:unknownversion
echo @COMMAND@: cannot tell the Java version of %JAVACMD%. Cringle needs a JDK 21 or newer. 1>&2
exit /b 1

:tooold
echo @COMMAND@: %JAVACMD% is Java %JAVA_FULL%, but Cringle needs a JDK 21 or newer. Set JAVA_HOME to a JDK 21. 1>&2
exit /b 1
