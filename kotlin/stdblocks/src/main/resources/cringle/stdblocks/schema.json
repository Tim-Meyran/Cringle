{
  "namespace": "cringle.stdblocks",
  "types": {
    "TimerTriggerConfig": {
      "record": {
        "intervalMs": "cringle.std/Int",
        "initialDelayMs": { "optional": "cringle.std/Int" },
        "count": { "optional": "cringle.std/Int" }
      }
    },
    "ConstantConfig": {
      "record": {
        "value": "cringle.std/String"
      }
    },
    "LogConfig": {
      "record": {
        "level": { "optional": "LogLevel" },
        "prefix": { "optional": "cringle.std/String" }
      }
    },
    "TempDirConfig": {
      "record": {
        "prefix": { "optional": "cringle.std/String" }
      }
    },
    "FileWriteConfig": {
      "record": {
        "name": { "optional": "cringle.std/String" },
        "append": { "optional": "cringle.std/Boolean" }
      }
    },
    "FileReadConfig": {
      "record": {
        "name": { "optional": "cringle.std/String" }
      }
    },
    "FileWatchConfig": {
      "record": {
        "path": { "optional": "cringle.std/String" },
        "intervalMs": { "optional": "cringle.std/Int" },
        "reportExisting": { "optional": "cringle.std/Boolean" }
      }
    },
    "ConcatConfig": { "record": { "separator": { "optional": "cringle.std/String" } } },
    "TemplateConfig": { "record": { "template": "cringle.std/String" } },
    "SplitConfig": { "record": { "separator": "cringle.std/String" } },
    "ReplaceConfig": {
      "record": {
        "find": "cringle.std/String",
        "replacement": { "optional": "cringle.std/String" },
        "regex": { "optional": "cringle.std/Boolean" }
      }
    },
    "RegexMatchConfig": {
      "record": {
        "pattern": "cringle.std/String",
        "group": { "optional": "cringle.std/Int" }
      }
    },
    "ContainsConfig": { "record": { "needle": "cringle.std/String" } },
    "MathConstantConfig": { "record": { "value": "cringle.std/Double" } },
    "RoundConfig": { "record": { "decimals": { "optional": "cringle.std/Int" } } },
    "RandomConfig": {
      "record": {
        "min": { "optional": "cringle.std/Double" },
        "max": { "optional": "cringle.std/Double" }
      }
    },
    "CounterConfig": {
      "record": {
        "start": { "optional": "cringle.std/Int" },
        "step": { "optional": "cringle.std/Int" }
      }
    },
    "CompareOperator": { "enum": ["EQ", "NE", "LT", "LE", "GT", "GE"] },
    "CompareConfig": { "record": { "operator": { "optional": "CompareOperator" } } },
    "DelayConfig": { "record": { "delayMs": "cringle.std/Int" } },
    "DebounceConfig": { "record": { "quietMs": "cringle.std/Int" } },
    "ThrottleConfig": { "record": { "intervalMs": "cringle.std/Int" } },
    "BufferConfig": { "record": { "size": { "optional": "cringle.std/Int" } } },
    "PathConfig": { "record": { "path": "cringle.std/String" } },
    "TextInputConfig": { "record": { "value": "cringle.std/String" } },
    "NumberInputConfig": { "record": { "value": "cringle.std/Double" } },
    "VariableName": {
      "string": { "pattern": "[A-Za-z][A-Za-z0-9_]*", "maxLength": 64, "description": "a name like name or order_id (letters, digits and _)" }
    },
    "TextFormatConfig": {
      "record": {
        "template": "cringle.std/String",
        "variables": { "optional": { "list": "VariableName" } }
      }
    },
    "HttpMethod": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    "HttpPath": {
      "string": {
        "pattern": "/(((\\{[A-Za-z][A-Za-z0-9_]*\\})|[^\\s/?#{}]+)(/((\\{[A-Za-z][A-Za-z0-9_]*\\})|[^\\s/?#{}]+))*/?)?",
        "maxLength": 200,
        "description": "a path that starts with '/', like /orders or /orders/{id} (no blank, '?', '#' or '//')"
      }
    },
    "HttpTimeout": { "int": { "minimum": 1, "maximum": 600000, "description": "milliseconds, 1 to 600000" } },
    "HttpStatus": { "int": { "minimum": 100, "maximum": 599, "description": "an HTTP status, 100 to 599" } },
    "HttpContentType": {
      "string": {
        "pattern": "[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(;.*)?",
        "description": "a media type like application/json or text/csv"
      }
    },
    "HttpRequestPart": {
      "string": {
        "pattern": "body|method|path|user|(params|query|headers)\\.\\S+",
        "description": "body, method, path, user, or params.<name>, query.<name>, headers.<name>"
      }
    },
    "HttpRequest": {
      "record": {
        "method": "cringle.std/String",
        "path": "cringle.std/String",
        "params": { "map": "cringle.std/String" },
        "query": { "map": "cringle.std/String" },
        "headers": { "map": "cringle.std/String" },
        "body": "cringle.std/String",
        "user": { "optional": "cringle.std/String" }
      }
    },
    "HttpResponse": {
      "record": {
        "status": { "optional": "cringle.std/Int" },
        "headers": { "optional": { "map": "cringle.std/String" } },
        "body": { "optional": "cringle.std/Any" }
      }
    },
    "HttpEndpointConfig": {
      "record": {
        "path": "HttpPath",
        "method": { "optional": "HttpMethod" },
        "auth": { "optional": "cringle.std/Boolean" },
        "timeoutMs": { "optional": "HttpTimeout" },
        "contentType": { "optional": "HttpContentType" }
      }
    },
    "HttpResponseConfig": {
      "record": {
        "status": { "optional": "HttpStatus" },
        "contentType": { "optional": "HttpContentType" },
        "headers": { "optional": { "map": "cringle.std/String" } },
        "body": { "optional": "cringle.std/String" }
      }
    },
    "HttpRequestFieldConfig": {
      "record": {
        "field": "HttpRequestPart",
        "json": { "optional": "cringle.std/Boolean" }
      }
    },
    "JsonInputConfig": { "record": { "value": "cringle.std/String" } },
    "LogWriteConfig": {
      "record": {
        "level": { "optional": "LogLevel" },
        "prefix": { "optional": "cringle.std/String" },
        "template": { "optional": "cringle.std/String" }
      }
    },
    "DwhWriteConfig": {
      "record": {
        "key": "cringle.std/String",
        "tags": { "optional": { "map": "cringle.std/String" } }
      }
    },
    "DwhStoreConfig": {
      "record": {
        "key": "cringle.std/String",
        "tags": { "optional": { "map": "cringle.std/String" } },
        "limit": { "optional": "cringle.std/Int" },
        "lastMs": { "optional": "cringle.std/Int" }
      }
    },
    "LogLevel": { "enum": ["DEBUG", "INFO", "WARN", "ERROR"] }
  }
}
